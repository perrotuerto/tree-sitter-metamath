{
  "name": "tree-sitter-metamath",
  "version": "0.1.0",
  "description": "A simple and flexible computer-processable language that supports rigorously verifying, archiving, and presenting mathematical proofs.",
  "type": "module",
  "repository": "https://github.com/tree-sitter/tree-sitter-metamath",
  "license": "MIT",
  "author": {
    "name": "Ramiro Santa Ana Anguiano",
    "email": "hi@colima.press"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": ["incremental", "parsing", "tree-sitter", "metamath"],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.25.8"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.4"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
